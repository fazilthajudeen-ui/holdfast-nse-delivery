{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "terminal",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "app.server", "--no-open", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "terminal-8001",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "app.server", "--no-open", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "app/streamlit_app.py", "--server.port", "8501"],
      "port": 8501
    }
  ]
}
